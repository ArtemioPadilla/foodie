{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/es/index.html",
        "http://localhost/fr/index.html",
        "http://localhost/recipes/index.html",
        "http://localhost/recipes/rec_001/index.html",
        "http://localhost/planner/index.html",
        "http://localhost/tracking/progress/index.html"
      ],
      "numberOfRuns": 1,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--headless --no-sandbox"
      }
    },
    "assert": {
      "//": "Gate on category scores (roadmap Issue 045: performance ≥ 0.9, accessibility ≥ 0.95, best-practices = 1, SEO ≥ 0.95, all error level) plus Core Web Vitals (warn: informative, not release-blocking). Category scores already aggregate the granular audits, so the lighthouse:no-pwa preset is deliberately not used. Byte budgets live in lighthouse-budgets.json and are asserted by a second `lhci assert --budgetsFile` pass (Lighthouse 12 dropped in-report budgets, and lhci cannot mix budgetsFile with assertions in one pass). Runs over the static dist/ in .github/workflows/lighthouse.yml and locally via npm run perf / npm run lighthouse.",
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 1
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "first-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2000
          }
        ],
        "largest-contentful-paint": [
          "warn",
          {
            "maxNumericValue": 2500
          }
        ],
        "cumulative-layout-shift": [
          "warn",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "warn",
          {
            "maxNumericValue": 300
          }
        ]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
