---
/**
 * Pantry — the `/pantry/` page body (roadmap Issue 027, D4 "una página por
 * ruta, una isla por página"; port of legacy `PantryPage`).
 *
 * Rendered by the thin wrappers `pages/pantry.astro`, `pages/es/pantry.astro`
 * and `pages/fr/pantry.astro`, which own the `<BaseLayout>` metadata. The
 * heading and help text are static HTML; the inventory lives in
 * `localStorage`, so everything else is the `Pantry` island, hydrated with
 * `client:load`.
 */
import { InfoIcon } from 'lucide-react';
import Pantry from '@/components/islands/Pantry';
import { t, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<main id="main-content" class="mx-auto max-w-5xl px-4 py-10 sm:py-14" data-page="pantry">
  <header class="mb-8 max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">{t(lang, 'pantry.kicker')}</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      style="view-transition-name: page-title"
    >
      {t(lang, 'pantry.title')}
    </h1>
    <p class="mt-4 text-muted-foreground">{t(lang, 'pantry.description')}</p>
  </header>

  <Pantry lang={lang} client:load />

  <aside class="mt-10 flex gap-3 rounded-lg border border-border bg-muted/40 p-4 text-sm" aria-labelledby="pantry-help-title">
    <InfoIcon className="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
    <div>
      <p id="pantry-help-title" class="font-medium text-foreground">{t(lang, 'pantry.helpTitle')}</p>
      <p class="mt-1 text-muted-foreground">{t(lang, 'pantry.helpText')}</p>
    </div>
  </aside>
</main>
