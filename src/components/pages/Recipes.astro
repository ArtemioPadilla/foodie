---
/**
 * Recipes — the `/recipes/` page body (roadmap Issue 017, D4 "una página por
 * ruta, una isla por página").
 *
 * Rendered by the thin wrappers `pages/recipes/index.astro`,
 * `pages/es/recipes/index.astro` and `pages/fr/recipes/index.astro`, which own
 * the `<BaseLayout>` metadata. The heading is static HTML (SEO, no JS); the
 * catalog browsing — search, filters in the URL, sort, grid/list — is the
 * `RecipeBrowser` island, hydrated with `client:load` because the page has no
 * content without it.
 */
import RecipeBrowser from '@/components/islands/RecipeBrowser';
import { t, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<main id="main-content" class="mx-auto max-w-7xl px-4 py-10 sm:py-14" data-page="recipes">
  <header class="mb-8 max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">{t(lang, 'nav.recipes')}</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      style="view-transition-name: page-title"
    >
      {t(lang, 'recipe.title')}
    </h1>
    <p class="mt-4 text-muted-foreground">{t(lang, 'recipe.browseDescription')}</p>
  </header>

  <RecipeBrowser lang={lang} client:load />
</main>
