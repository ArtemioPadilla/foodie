---
/**
 * Contribute — the `/contribute/` page body (roadmap Issue 038, D10; port of
 * legacy `ContributePage`).
 *
 * Rendered by the thin wrappers `pages/contribute.astro`,
 * `pages/es/contribute.astro` and `pages/fr/contribute.astro`, which own the
 * `<BaseLayout>` metadata. The heading is static; the wizard (form state,
 * draft in `localStorage`, catalog pickers, preview) is the single
 * `ContributeWizard` island, hydrated with `client:load`.
 */
import { InfoIcon } from 'lucide-react';
import ContributeWizard from '@/components/islands/ContributeWizard';
import { t, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<main id="main-content" class="mx-auto max-w-5xl px-4 py-10 sm:py-14" data-page="contribute">
  <header class="mb-8 max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">{t(lang, 'contribute.kicker')}</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      style="view-transition-name: page-title"
    >
      {t(lang, 'contribute.title')}
    </h1>
    <p class="mt-4 text-muted-foreground">{t(lang, 'contribute.pageDescription')}</p>
  </header>

  <ContributeWizard lang={lang} client:load />

  <aside class="mt-10 flex gap-3 rounded-lg border border-border bg-muted/40 p-4 text-sm" aria-labelledby="contribute-guidelines-title">
    <InfoIcon className="mt-0.5 size-5 shrink-0 text-primary" aria-hidden="true" />
    <p id="contribute-guidelines-title" class="text-muted-foreground">{t(lang, 'contribute.guidelines')}</p>
  </aside>
</main>
