---
/**
 * Ingredients — the `/ingredients/` page body (roadmap Issue 019, D4 "una
 * página por ruta, una isla por página"; port of legacy `IngredientsPage`).
 *
 * Rendered by the thin wrappers `pages/ingredients/index.astro`,
 * `pages/es/ingredients/index.astro` and `pages/fr/ingredients/index.astro`,
 * which own the `<BaseLayout>` metadata. The heading is static HTML; search,
 * category/dietary filters, grouping and "Recipes you can make" are the
 * `IngredientBrowser` island, hydrated with `client:load` because the page
 * has no content without it.
 */
import IngredientBrowser from '@/components/islands/IngredientBrowser';
import { t, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<main id="main-content" class="mx-auto max-w-7xl px-4 py-10 sm:py-14" data-page="ingredients">
  <header class="mb-8 max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">{t(lang, 'nav.ingredients')}</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      style="view-transition-name: page-title"
    >
      {t(lang, 'ingredients.title')}
    </h1>
    <p class="mt-4 text-muted-foreground">{t(lang, 'ingredients.browseDescription')}</p>
  </header>

  <IngredientBrowser lang={lang} client:load />
</main>
