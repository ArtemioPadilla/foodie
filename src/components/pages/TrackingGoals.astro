---
/**
 * TrackingGoals — the `/tracking/goals/` page body (roadmap Issue 032; port of
 * legacy `GoalsPage`).
 *
 * Rendered by the thin wrappers `pages/tracking/goals.astro`,
 * `pages/es/tracking/goals.astro` and `pages/fr/tracking/goals.astro`, which
 * own the `<BaseLayout>` metadata. The heading is static HTML; the goals
 * live in `localStorage` (`nutritionGoals` — ADR 0002), so the form is the
 * `GoalsForm` island, hydrated with `client:load`.
 */
import GoalsForm from '@/components/islands/GoalsForm';
import { t, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
---

<main id="main-content" class="mx-auto max-w-5xl px-4 py-10 sm:py-14" data-page="tracking-goals">
  <header class="mb-8 max-w-3xl">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">{t(lang, 'goals.kicker')}</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-foreground sm:text-5xl"
      style="view-transition-name: page-title"
    >
      {t(lang, 'goals.title')}
    </h1>
    <p class="mt-4 text-muted-foreground">{t(lang, 'goals.pageDescription')}</p>
  </header>

  <GoalsForm lang={lang} client:load />
</main>
