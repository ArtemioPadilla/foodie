---
/**
 * Home — the Foodie landing body (roadmap Issue 005, D4 "una página por ruta").
 *
 * Rendered by the thin wrappers `pages/index.astro`, `pages/es/index.astro`
 * and `pages/fr/index.astro`, which own the `<BaseLayout>` (title, hreflang
 * alternates, JSON-LD). Everything here is static HTML: the six feature cards
 * come from the legacy `HomePage.tsx` (four) plus the two sections the
 * definitive navigation adds (ingredients, tracking).
 *
 * Stats are honest build-time numbers read from `public/data/*.json` — the
 * single catalog source (D6) — so the landing never claims more recipes than
 * the site ships.
 */
import { withBase } from '@/lib/href';
import { REPO_URL } from '@/lib/site-meta';
import { LOCALES, localizedRoute, t, type Locale } from '@/i18n';
// Build-time catalog counts. Vite resolves these JSON imports when the page is
// rendered at build, so the numbers always match the files that ship with the
// site; nothing here reaches the client bundle. (Issue 011 turns the same
// files into content collections — the counts will move to getCollection().)
import recipesData from '../../../public/data/recipes.json';
import ingredientsData from '../../../public/data/ingredients.json';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;

const countOf = (data: unknown, key: string): number => {
  const list = (data as Record<string, unknown>)[key];
  return Array.isArray(list) ? list.length : 0;
};
const recipeCount = countOf(recipesData, 'recipes');
const ingredientCount = countOf(ingredientsData, 'ingredients');

const href = (route: string) => withBase(localizedRoute(route, lang));

const stats = [
  { value: String(recipeCount), label: t(lang, 'home.statRecipes') },
  { value: String(ingredientCount), label: t(lang, 'home.statIngredients') },
  { value: String(LOCALES.length), label: t(lang, 'home.statLanguages') },
  { value: '0', label: t(lang, 'home.statAccounts') },
];

// Icon paths are lucide outlines inlined as SVG so the landing ships no JS.
const features = [
  {
    route: '/recipes/',
    title: t(lang, 'home.feature1Title'),
    description: t(lang, 'home.feature1Description'),
    icon: '<path d="M17 21a1 1 0 0 0 1-1v-5.35c0-.457.316-.844.727-1.041a4 4 0 0 0-2.134-7.589 5 5 0 0 0-9.186 0 4 4 0 0 0-2.134 7.588c.411.198.727.585.727 1.041V20a1 1 0 0 0 1 1Z"/><path d="M6 17h12"/>',
  },
  {
    route: '/ingredients/',
    title: t(lang, 'home.feature2Title'),
    description: t(lang, 'home.feature2Description'),
    icon: '<path d="M2.27 21.7s9.87-3.5 12.73-6.36a4.5 4.5 0 0 0-6.36-6.37C5.77 11.84 2.27 21.7 2.27 21.7zM8.64 14l-2.05-2.04M15.34 15l-2.46-2.46"/><path d="M22 9s-1.33-2-3.5-2C16.86 7 15 9 15 9s1.33 2 3.5 2S22 9 22 9z"/><path d="M15 2s-2 1.33-2 3.5S15 9 15 9s2-1.84 2-3.5C17 3.33 15 2 15 2z"/>',
  },
  {
    route: '/planner/',
    title: t(lang, 'home.feature3Title'),
    description: t(lang, 'home.feature3Description'),
    icon: '<path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/>',
  },
  {
    route: '/shopping/',
    title: t(lang, 'home.feature4Title'),
    description: t(lang, 'home.feature4Description'),
    icon: '<circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>',
  },
  {
    route: '/pantry/',
    title: t(lang, 'home.feature5Title'),
    description: t(lang, 'home.feature5Description'),
    icon: '<path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
  },
  {
    route: '/tracking/',
    title: t(lang, 'home.feature6Title'),
    description: t(lang, 'home.feature6Description'),
    icon: '<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/>',
  },
];
---

<main id="main-content" class="relative">
  <!-- ═══ Hero ═══════════════════════════════════════════════════════════ -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute left-1/2 top-0 h-[32rem] w-[52rem] -translate-x-1/2 rounded-full bg-primary/15 blur-3xl"></div>
    </div>

    <div class="mx-auto flex max-w-6xl flex-col items-center px-4 pb-16 pt-20 text-center sm:pt-28">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">{t(lang, 'home.kicker')}</p>
      <h1
        class="mt-4 max-w-3xl font-display text-4xl font-semibold tracking-tight text-foreground sm:text-6xl"
        style="view-transition-name: page-title"
      >
        {t(lang, 'home.title')}
        <span class="text-primary">{t(lang, 'home.titleEmphasis')}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-base text-muted-foreground sm:text-lg">{t(lang, 'home.tagline')}</p>

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a
          href={href('/recipes/')}
          data-testid="hero-cta-recipes"
          class="group inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/30"
        >
          {t(lang, 'home.ctaPrimary')}
          <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
        </a>
        <a
          href={href('/planner/')}
          data-testid="hero-cta-planner"
          class="inline-flex items-center gap-2 rounded-xl border border-border bg-card/60 px-6 py-3 text-sm font-semibold text-foreground backdrop-blur transition-colors hover:border-primary/40 hover:bg-accent/50"
        >
          {t(lang, 'home.ctaSecondary')}
        </a>
      </div>

      <!-- Honest catalog stats -->
      <dl class="mt-14 grid w-full max-w-3xl grid-cols-2 gap-px overflow-hidden rounded-xl border border-border bg-border sm:grid-cols-4">
        {
          stats.map((s) => (
            <div class="flex flex-col items-center bg-card px-4 py-5">
              <dd class="order-1 font-display text-3xl font-semibold tracking-tight text-foreground">{s.value}</dd>
              <dt class="order-2 mt-1 font-mono text-[0.68rem] uppercase tracking-[0.15em] text-muted-foreground">{s.label}</dt>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- ═══ Feature cards ═══════════════════════════════════════════════════ -->
  <section class="border-t border-border bg-muted/30" aria-labelledby="features-heading">
    <div class="mx-auto max-w-6xl px-4 py-20">
      <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">{t(lang, 'home.featuresKicker')}</p>
      <h2 id="features-heading" class="mt-3 font-display text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
        {t(lang, 'home.featuresHeading')}
      </h2>

      <ul class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {
          features.map((f) => (
            <li>
              <a
                href={href(f.route)}
                class="group flex h-full flex-col gap-4 rounded-2xl border border-border bg-card p-6 transition-all hover:-translate-y-0.5 hover:border-primary/50 hover:shadow-lg hover:shadow-primary/10"
              >
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-primary-foreground">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="22"
                    height="22"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={f.icon}
                  />
                </span>
                <span class="flex flex-col gap-1.5">
                  <span class="font-display text-lg font-semibold text-foreground">{f.title}</span>
                  <span class="text-sm leading-relaxed text-muted-foreground">{f.description}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- ═══ Contribute CTA ══════════════════════════════════════════════════ -->
  <section class="border-t border-border" aria-labelledby="contribute-heading">
    <div class="mx-auto flex max-w-3xl flex-col items-center px-4 py-20 text-center">
      <h2 id="contribute-heading" class="font-display text-3xl font-semibold tracking-tight text-foreground sm:text-4xl">
        {t(lang, 'home.readyToStart')}
      </h2>
      <p class="mt-4 max-w-xl text-muted-foreground">{t(lang, 'home.joinUsers')}</p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href={href('/contribute/')}
          class="inline-flex items-center gap-2 rounded-xl bg-primary px-6 py-3 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:-translate-y-0.5 hover:shadow-xl hover:shadow-primary/30"
        >
          {t(lang, 'home.contributeRecipe')}
        </a>
        <a
          href={REPO_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 rounded-xl border border-border px-6 py-3 font-mono text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-primary"
        >
          {t(lang, 'home.viewSource')} ↗
        </a>
      </div>
    </div>
  </section>
</main>
