---
/**
 * ComingSoon — trilingual placeholder for sections that are in the definitive
 * navigation but not migrated yet (roadmap Issue 005).
 *
 * Each `/recipes/`, `/es/recipes/`, `/fr/recipes/` … page is a one-line
 * wrapper over this component, so `route-parity` stays green and the header
 * links never 404 while Phases 1–4 land. When the real page ships, the wrapper
 * is replaced and this component simply has one fewer consumer.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { withBase } from '@/lib/href';
import { REPO_URL, SITE, SITE_ORIGIN } from '@/lib/site-meta';
import { hreflangAlternates, localizedRoute, t, type Locale } from '@/i18n';

interface Props {
  lang: Locale;
  /** Route without base or locale prefix, e.g. `/recipes/`. */
  route: string;
  /** `nav.*` key naming the section, e.g. `recipes`. */
  section: string;
}

const { lang, route, section } = Astro.props;
const sectionLabel = t(lang, `nav.${section}`);
const title = t(lang, 'comingSoon.title', { section: sectionLabel });
const alternates = hreflangAlternates(route, (Astro.site ?? new URL(SITE_ORIGIN)).origin, import.meta.env.BASE_URL);
---

<BaseLayout title={`${SITE.name} — ${sectionLabel}`} description={t(lang, 'comingSoon.body')} lang={lang} alternates={alternates}>
  <main id="main-content" class="mx-auto flex max-w-3xl flex-col px-4 py-24" data-page="coming-soon" data-section={section}>
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">{t(lang, 'comingSoon.kicker')}</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-foreground"
      style="view-transition-name: page-title"
    >
      {title}
    </h1>
    <p class="mt-4 max-w-prose text-muted-foreground">{t(lang, 'comingSoon.body')}</p>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a
        href={withBase(localizedRoute('/', lang))}
        class="inline-flex items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:-translate-y-0.5"
      >
        ← {t(lang, 'comingSoon.backHome')}
      </a>
      <a
        href={`${REPO_URL}/issues`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-xl border border-border px-5 py-2.5 font-mono text-sm text-muted-foreground transition-colors hover:border-primary/40 hover:text-primary"
      >
        {t(lang, 'comingSoon.followProgress')} ↗
      </a>
    </div>
  </main>
</BaseLayout>
