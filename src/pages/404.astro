---
/**
 * 404 — Astro emits this as dist/404.html, which GitHub Pages serves for any
 * unknown path under the project site. It replaces both the default GitHub
 * 404 and the legacy SPA trick (`public/404.html` + `404-redirect.js` +
 * `spa-redirect.js`) — every Foodie route is now a real static page (D4), so
 * nothing needs to be re-routed client-side (roadmap Issue 005).
 *
 * This page is English-only (there is one 404.html per site) and therefore
 * offers the way home in every language.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/href';
import { LOCALES, LOCALE_NAMES, localizedRoute, t } from '../i18n';

const homes = LOCALES.map((locale) => ({
  locale,
  href: withBase(localizedRoute('/', locale)),
  label: t(locale, 'nav.home'),
  name: LOCALE_NAMES[locale],
}));
---

<BaseLayout title={`${t('en', 'notFound.title')} — Foodie`} description={t('en', 'notFound.body')} lang="en">
  <main id="main-content" class="mx-auto flex max-w-3xl flex-col px-4 py-24">
    <p class="font-mono text-xs uppercase tracking-[0.2em] text-primary">{t('en', 'notFound.kicker')}</p>
    <h1
      class="mt-3 font-display text-4xl font-semibold tracking-tight text-foreground"
      style="view-transition-name: page-title"
    >
      {t('en', 'notFound.title')}
    </h1>
    <p class="mt-4 max-w-prose text-muted-foreground">{t('en', 'notFound.body')}</p>

    <nav aria-label={t('en', 'notFound.homeHeading')} class="mt-10">
      <p class="mb-3 font-mono text-[0.65rem] uppercase tracking-[0.18em] text-primary">{t('en', 'notFound.homeHeading')}</p>
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {
          homes.map((h) => (
            <li>
              <a
                href={h.href}
                hreflang={h.locale}
                lang={h.locale}
                class="flex items-baseline justify-between gap-3 rounded-lg border border-border bg-card px-4 py-3 transition-colors hover:border-primary/50 hover:bg-accent"
              >
                <span class="font-medium text-foreground">{h.label}</span>
                <span class="font-mono text-xs text-muted-foreground">{h.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a
      href={withBase('/recipes/')}
      class="mt-8 inline-flex w-fit items-center gap-2 rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-primary-foreground shadow-lg shadow-primary/20 transition-all hover:-translate-y-0.5"
    >
      {t('en', 'notFound.browseRecipes')} →
    </a>
  </main>
</BaseLayout>
