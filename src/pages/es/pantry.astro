---
/**
 * `/pantry/` wrapper for `es` (roadmap Issue 027). The page body lives in
 * `components/pages/Pantry.astro`; this file owns the layout metadata for
 * this locale (title, description, hreflang alternates).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Pantry from '@/components/pages/Pantry.astro';
import { SITE, SITE_ORIGIN } from '@/lib/site-meta';
import { hreflangAlternates, t } from '@/i18n';

const lang = 'es' as const;
const alternates = hreflangAlternates('/pantry/', (Astro.site ?? new URL(SITE_ORIGIN)).origin, import.meta.env.BASE_URL);
---

<BaseLayout
  title={`${SITE.name} — ${t(lang, 'pantry.title')}`}
  description={t(lang, 'pantry.description')}
  lang={lang}
  alternates={alternates}
>
  <Pantry lang={lang} />
</BaseLayout>
