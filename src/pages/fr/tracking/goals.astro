---
/**
 * `/tracking/goals/` wrapper for `fr` (roadmap Issue 032). The page body lives
 * in `components/pages/TrackingGoals.astro`; this file owns the layout
 * metadata for this locale (title, description, hreflang alternates).
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TrackingGoals from '@/components/pages/TrackingGoals.astro';
import { SITE, SITE_ORIGIN } from '@/lib/site-meta';
import { hreflangAlternates, t } from '@/i18n';

const lang = 'fr' as const;
const alternates = hreflangAlternates('/tracking/goals/', (Astro.site ?? new URL(SITE_ORIGIN)).origin, import.meta.env.BASE_URL);
---

<BaseLayout
  title={`${SITE.name} — ${t(lang, 'goals.title')}`}
  description={t(lang, 'goals.pageDescription')}
  lang={lang}
  alternates={alternates}
>
  <TrackingGoals lang={lang} />
</BaseLayout>
