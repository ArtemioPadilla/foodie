---
/**
 * `/planner/` wrapper for `fr` (roadmap Issue 024). The page body lives in
 * `components/pages/Planner.astro`; this file owns the layout metadata for
 * this locale (title, description, hreflang alternates).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Planner from '@/components/pages/Planner.astro';
import { SITE, SITE_ORIGIN } from '@/lib/site-meta';
import { hreflangAlternates, t } from '@/i18n';

const lang = 'fr' as const;
const alternates = hreflangAlternates('/planner/', (Astro.site ?? new URL(SITE_ORIGIN)).origin, import.meta.env.BASE_URL);
---

<BaseLayout
  title={`${SITE.name} — ${t(lang, 'planner.title')}`}
  description={t(lang, 'planner.description')}
  lang={lang}
  alternates={alternates}
>
  <Planner lang={lang} />
</BaseLayout>
