# Example environment file for Foodie.
#
# Copy to `.env` for local development, or set these in your deploy host's
# env config (Cloudflare Pages, Netlify, Vercel, GitHub Actions secrets, etc.).
#
# Everything prefixed PUBLIC_ is inlined into the browser bundle at build
# time — never put real secrets here. Server-only secrets would use a
# different prefix; this scaffold has no backend yet.

# --- Build metadata ---------------------------------------------------------

# Release channel: production | preview | development
# Affects flags.channel and the Sentry sample rate.
PUBLIC_CHANNEL=development

# Build SHA + version surface on the FeedbackFAB diagnostics and on <html data-app-version>. CI normally
# injects these from $GITHUB_SHA and package.json; leave unset locally.
PUBLIC_BUILD_SHA=
PUBLIC_VERSION=

# --- Repo wiring ------------------------------------------------------------

# Opt-in GitHub wiring (ADR 0015). When set to `<owner>/<repo>`, the site links
# the repository (header, footer, docs "edit this page"), shows the FeedbackFAB
# and the contribute wizard opens a prefilled recipe-submission issue (roadmap
# #039). A name, not a credential: Foodie holds no GitHub token or OAuth app
# (D10). Leave it empty — the default and the production build — and the site
# names no repository at all.
PUBLIC_REPO_SLUG=

# Canonical origin (build-time, not PUBLIC_): canonical/OG/hreflang/sitemap/
# robots/JSON-LD. Empty = https://eat.cybere.co (site.config.mjs).
SITE_ORIGIN=

# --- Feature flags ----------------------------------------------------------
# All flags accept: true / false / 1 / 0 / on / off / yes / no.
# Defaults are coded in src/lib/flags.ts.

# Component gallery (/gallery/, roadmap Issue 046). Unset = on in dev and in
# local/CI builds, off in the production deploy (FOODIE_DEPLOY=1). Set it to
# force either way; astro.config.mjs only builds the gallery pages when on.
# PUBLIC_FLAG_EXPERIMENTAL_GALLERY=
PUBLIC_FLAG_FEEDBACK_FAB=true
PUBLIC_FLAG_DOCS_SEARCH=true
PUBLIC_FLAG_PWA_PROMPTS=true

# --- Auth: Firebase (roadmap D9, Issue 035, ADR 0012) ----------------------

# Firebase web-app config (Firebase console → Project settings → Your apps).
# All four must be set to enable sign-in; if any is missing the build still
# succeeds and auth is disabled (or mocked in dev). These identify the project
# — they are not secrets — but CI injects them from repository secrets so
# forks never sign into Foodie's project. Restrict the API key to the
# deployed origins in Google Cloud console.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_APP_ID=

# Force the in-memory mock adapter (src/lib/auth/mock.ts): 1 / true / on.
# Used by the e2e build; dev without Firebase config already uses the mock.
# Demo account: demo@foodie.test / foodie-demo. NEVER set in production:
# astro.config.mjs fails the build when it is set together with FOODIE_DEPLOY=1
# (the deploy workflow) or with a complete PUBLIC_FIREBASE_* config.
PUBLIC_AUTH_MOCK=

# --- Error monitoring (Sentry skeleton, off by default) ---------------------

# Install @sentry/browser AND set both of these to wire real Sentry.
# Without the npm package, the skeleton in src/lib/sentry.ts falls back to
# console.error — no runtime crash.
PUBLIC_FLAG_SENTRY=false
PUBLIC_SENTRY_DSN=

# --- Analytics (skeleton, off by default) -----------------------------------

# Provider script tag injected by src/lib/analytics.ts when enabled.
# Choose plausible (default) or umami. Self-hosters: override script URL.
PUBLIC_FLAG_ANALYTICS=false
PUBLIC_ANALYTICS_PROVIDER=plausible
PUBLIC_ANALYTICS_DOMAIN=
PUBLIC_ANALYTICS_SCRIPT_URL=
